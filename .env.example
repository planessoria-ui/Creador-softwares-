# ---- Claude (guió) ----------------------------------------------------------
# Obligatori per generar guions. Alternativa: fes `ant auth login` i deixa-ho buit.
ANTHROPIC_API_KEY=
# Model per escriure els diàlegs (per defecte claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# ---- Veus (TTS) -------------------------------------------------------------
# auto | elevenlabs | openai | edge | silent
# auto = elevenlabs si hi ha clau, si no openai si hi ha clau, si no edge (gratuït), si no silent
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
# Opcional: model d'ElevenLabs (per defecte eleven_multilingual_v2; per al català cal eleven_v3)
ELEVENLABS_MODEL=
# Opcional: fixa una veu concreta per arquetip amb el seu Voice ID, p. ex.:
# ELEVENLABS_VOICE_DEEP_MALE=nPczCjzI2devNBz1zQrb
# Arquetips: DEEP_MALE WARM_MALE ENERGETIC_MALE GRUMPY_OLD_MALE WARM_FEMALE ENERGETIC_FEMALE SASSY_FEMALE SQUEAKY KID
OPENAI_API_KEY=

# ---- Render -----------------------------------------------------------------
# Ruta a un Chrome/Chromium local. Si es deixa buit, Remotion descarrega el seu propi navegador.
REMOTION_BROWSER_EXECUTABLE=
# Nombre de pestanyes de render en paral·lel (per defecte: la meitat dels nuclis)
RENDER_CONCURRENCY=

# ---- Servidor ---------------------------------------------------------------
PORT=3000
# Text de marca que surt a la targeta final (p. ex. @elmeunegoci)
BRAND_HANDLE=
# Idioma seleccionat per defecte a la web: ca | es | en
DEFAULT_LANGUAGE=ca
