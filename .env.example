# ---- Claude (guió) ----------------------------------------------------------
# Obligatori per generar guions. Alternativa: fes `ant auth login` i deixa-ho buit.
ANTHROPIC_API_KEY=
# Model per escriure els diàlegs (per defecte claude-opus-5)
CLAUDE_MODEL=claude-opus-5

# ---- Veus (TTS) -------------------------------------------------------------
# auto | elevenlabs | openai | edge | silent
# auto = elevenlabs si hi ha clau, si no openai si hi ha clau, si no edge (gratuït), si no silent
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# ---- Render -----------------------------------------------------------------
# Ruta a un Chrome/Chromium local. Si es deixa buit, Remotion descarrega el seu propi navegador.
REMOTION_BROWSER_EXECUTABLE=
# Nombre de pestanyes de render en paral·lel (per defecte: la meitat dels nuclis)
RENDER_CONCURRENCY=

# ---- Servidor ---------------------------------------------------------------
PORT=3000
# Text de marca que surt a la targeta final (p. ex. @elmeunegoci)
BRAND_HANDLE=
