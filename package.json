    "@remotion/bundler": "^4.0.526",
    "@remotion/cli": "^4.0.526",
    "@remotion/media-utils": "^4.0.526",
    "@remotion/renderer": "^4.0.526",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "msedge-tts": "^2.0.7",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.526",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.1",
