{
  "name": "foodtalk-video-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Genera vídeos verticals (Reels / TikTok) amb personatges de menjar que parlen, a partir d'una imatge i un prompt.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
